# Copia este archivo como `keystore.properties` (que NO se sube al repositorio) y rellena
# los datos de tu clave de firma. Sin él, la build de release sale sin firmar y Play la
# rechaza al subirla.
#
# Para crear la clave, una sola vez:
#   keytool -genkey -v -keystore undiamas-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias undiamas
#
# Guarda el .jks y estas contraseñas en un sitio seguro: si se pierden, no se puede
# publicar ninguna actualización de la app nunca más.

storeFile=undiamas-release.jks
storePassword=CAMBIAME
keyAlias=undiamas
keyPassword=CAMBIAME
