<?xml version="1.0" encoding="utf-8"?>
<!--
    El dibujo del logo: amanecer, arco de luz, horizonte y el signo de más.

    Todo cabe entre 30 y 78 del lienzo de 108, dentro de la zona segura (21–87) que ningún
    lanzador recorta. El sol y la ola son el amanecer; el arco, la luz que vuelve.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sol. El círculo del SVG se vuelve trazado: VectorDrawable no tiene <circle>. -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M38,50a16,16 0 1,0 32,0a16,16 0 1,0 -32,0z" />

    <!-- Arco de luz -->
    <path
        android:pathData="M32,48A22,22 0 0,1 76,48"
        android:strokeColor="#60A5FA"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Ola / horizonte -->
    <path
        android:fillColor="#3B82F6"
        android:pathData="M30,66Q42,61 54,66T78,66L78,78L30,78Z" />

    <!-- Signo de más -->
    <path
        android:pathData="M68,34H76M72,30V38"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
