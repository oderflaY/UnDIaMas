# ---------------------------------------------------------------------------
# Plantilla de configuración. Copiar a .env (que está en .gitignore).
# Aquí NO va ninguna credencial real.
# ---------------------------------------------------------------------------

# Proyecto de Firebase. Ya está fijado en .firebaserc; esto es solo referencia
# para scripts que lo necesiten.
FIREBASE_PROJECT_ID=diamas-d11b4

# ---------------------------------------------------------------------------
# Configuración de la app Android
# ---------------------------------------------------------------------------
# El archivo androidApp/google-services.json NO se versiona (ver .gitignore).
# Se descarga de la consola de Firebase:
#   Configuración del proyecto > Tus apps > Android (com.eter.undiamas)
# El plugin com.google.gms.google-services lo procesa en tiempo de build.

# ---------------------------------------------------------------------------
# Clave de Gemini para el agente de IA
# ---------------------------------------------------------------------------
# La app NUNCA lleva esta clave: vive solo como secreto de Cloud Functions y se
# consume desde functions/src/index.ts vía defineSecret("GEMINI_API_KEY").
# Para configurarla (no la escribas en ningún archivo del repo):
#
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Y para el emulador local, en functions/.env.local (también ignorado por git):
#   GEMINI_API_KEY=...
